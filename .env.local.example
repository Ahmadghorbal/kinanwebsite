# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are exposed to the browser.

# Canonical site origin — used for canonical URLs, sitemap, and Open Graph.
# No trailing slash. In production set this to your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (optional until you connect a project) ---------------------------
# Leave PROJECT_ID blank to run the site on its built-in verified content.
# Once you create a Sanity project, paste its ID here to make the site CMS-driven.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only token (NOT NEXT_PUBLIC). Needs write access so the contact form
# and survey can store submissions/votes. Create it in Sanity → API → Tokens.
SANITY_API_WRITE_TOKEN=
